# AiLou Studio — variáveis de ambiente
# Cole este arquivo em Vercel → Project Settings → Environment Variables.
# Nenhuma chave real é commitada no repositório.

# Supabase (projeto AiLou Studio na organização AiLou Labs)
SUPABASE_URL="https://cbfloejnedhudfurayda.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# Precisam do prefixo VITE_ para chegarem no bundle do navegador (Vite substitui em build-time)
VITE_SUPABASE_URL="https://cbfloejnedhudfurayda.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# OpenAI (fallback do provedor de imagem e conserto de emenda com máscara)
OPENAI_API_KEY="sk-..."

# Google Gemini (Nano Banana 2 é o provedor principal desde 14/09/2026)
GEMINI_API_KEY="AIza..."

# Chave interna do processador de fila. Gere com: openssl rand -base64 32
GENERATION_WORKER_SECRET=""

# Opcional: endereço fixo pelo qual o processador se auto-aciona.
# Vazio = usa a origem da requisição (recomendado depois de fixar o domínio final).
WORKER_BASE_URL=""

# Opcional: Replicate para upscaling em alta fidelidade (não usado no MVP)
REPLICATE_API_TOKEN=""
